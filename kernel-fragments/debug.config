# Kernel debug — bikin bug diam-diam jadi berisik.
# Semua opsi diverifikasi ada di Kconfig kernel Mi-Thorium 4.19.
#
# JANGAN untuk pemakaian harian: kernel debug lebih lambat, boros RAM, dan
# beberapa opsi sengaja memicu panic. Pakai untuk berburu bug, lalu kembali
# ke kernel rilis.
#
# KASAN sengaja TIDAK dimasukkan: biaya RAM ~2-3x, tidak realistis di
# perangkat 2 GB seperti Redmi 5A.

# --- Tangkap crash yang biasa terlewat ---
# Oops → panic → tercatat pstore/ramoops (bisa dibaca setelah reboot).
CONFIG_PANIC_ON_OOPS=y
# Task yang macet >120s (indikasi deadlock / stall) → laporan + panic.
CONFIG_DETECT_HUNG_TASK=y
# Stack menabrak batas → ketahuan, bukan korupsi senyap.
CONFIG_SCHED_STACK_END_CHECK=y

# --- Relevan langsung untuk hook susfs/ReSukiSU kita ---
# Tidur di context atomic — adaptasi vfs_create_mount() jalan di jalur mount
# tiap filesystem; kalau ia sleep di tempat salah, ini yang menangkap.
CONFIG_DEBUG_PREEMPT=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
# Deteksi salah-pakai lock. CONFIG_PROVE_LOCKING (lockdep validator penuh)
# SENGAJA TIDAK dipakai: kernel/locking/lockdep.c di tree msm downstream ini
# sudah membusuk (fungsi mainline hilang) karena tak pernah dibangun, dan
# gagal kompilasi. DEBUG_SPINLOCK/MUTEXES tidak butuh lockdep dan tetap
# menangkap sebagian besar salah-pakai lock.
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y

# --- Nyalakan pr_debug() saat runtime tanpa rebuild ---
# Termasuk baris "fake uname..." dan log susfs lain, via
#   echo 'file fs/susfs.c +p' > /sys/kernel/debug/dynamic_debug/control
CONFIG_DYNAMIC_DEBUG=y
