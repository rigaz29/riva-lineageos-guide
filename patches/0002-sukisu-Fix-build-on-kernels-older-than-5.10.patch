From 2146d4f8c10c3f22b3778106b15c5e346ca596e2 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Sun, 26 Jul 2026 17:28:03 +0000
Subject: [PATCH] Fix build on kernels older than 5.10

Dua masalah membuat branch builtin gagal kompilasi di kernel 4.19:

1. ksu.c hanya meng-include feature/selinux_hide.{h,c} untuk
   LINUX_VERSION_CODE >= 5.10, tetapi runtime/ksud.c memanggil
   ksu_selinux_hide_handle_post_fs_data() dan _second_stage() tanpa
   syarat. Beri gerbang versi yang sama pada ketiga pemanggilan.

2. Makro USER_ARG_NULL di sulog/event.c mengembalikan
   struct user_arg_ptr *, sementara ksu_sulog_capture menerima
   struct user_arg_ptr by value.
---
 kernel/runtime/ksud.c | 6 ++++++
 kernel/sulog/event.c  | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/kernel/runtime/ksud.c b/kernel/runtime/ksud.c
index c9d11da..ee0ee75 100644
--- a/kernel/runtime/ksud.c
+++ b/kernel/runtime/ksud.c
@@ -61,7 +61,9 @@ void on_post_fs_data(void)
 #else
     stop_input_hook();
 #endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
     ksu_selinux_hide_handle_post_fs_data();
+#endif
 }
 
 extern void ext4_unregister_sysfs(struct super_block *sb);
@@ -223,7 +225,9 @@ int ksu_handle_execveat_ksud(int *fd, struct filename **filename_ptr,
             char buf[16];
             if (check_argv(*argv, 1, "second_stage", buf, sizeof(buf))) {
                 pr_info("/system/bin/init second_stage executed\n");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
                 ksu_selinux_hide_handle_second_stage();
+#endif
                 apply_kernelsu_rules();
                 cache_sid();
                 setup_ksu_cred();
@@ -295,7 +299,9 @@ int ksu_handle_execveat_ksud(int *fd, struct filename **filename_ptr, struct use
         char buf[16];
         if (!init_second_stage_executed && check_argv(*argv, 1, "second_stage", buf, sizeof(buf))) {
             pr_info("/system/bin/init second_stage executed\n");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
             ksu_selinux_hide_handle_second_stage();
+#endif
             apply_kernelsu_rules();
             cache_sid();
             setup_ksu_cred();
diff --git a/kernel/sulog/event.c b/kernel/sulog/event.c
index e45f01f..2f91639 100644
--- a/kernel/sulog/event.c
+++ b/kernel/sulog/event.c
@@ -374,7 +374,7 @@ static struct ksu_sulog_pending_event *ksu_sulog_capture_grant_root(const struct
     struct ksu_sulog_event *event;
 
     // This is actually stupid fix
-    #define USER_ARG_NULL user_arg_null_ptr()
+    #define USER_ARG_NULL (*user_arg_null_ptr())
 
     pending = ksu_sulog_capture(KSU_SULOG_EVENT_IOCTL_GRANT_ROOT, NULL, USER_ARG_NULL, gfp);
     if (!pending)
-- 
